text = "教程文档"

[node name="Body" type="Label" parent="HelpModal/Center/Card/Content"]
custom_minimum_size = Vector2(580, 0)
layout_mode = 2
text = "01   展开函数卡片，拖动滑条或输入数值，调整参数和定义域。\n02   每关最多三条函数；重叠轨道全部参与真实碰撞。\n03   蓝色直线和紫色正弦轨道提供支撑；金色二次轨道具有弹性。\n04   小球从起点自由下落，受重力影响，可以脱轨、反弹、跨越空隙。\n05   任意顺序触及所有金色检查点，再进入绿色终点。\n06   触及红色危险区、球心越界或超时都会失败。\n\n重试：保留当前函数、参数和定义域。\n重置：恢复本关最初的配置。\n\n滚轮上下平移；Shift + 滚轮左右平移；\nCtrl + 滚轮缩放；中键拖动；运行时固定全景。\n空格运行 / 暂停，R 重试，Esc 关闭弹窗 / 暂停。"
theme_override_colors/font_color = Color(0.745, 0.792, 0.851, 1)
autowrap_mode = 3

