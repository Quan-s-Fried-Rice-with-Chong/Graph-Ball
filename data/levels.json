    {
      "id":"tutorial_line", "title":"第一课 · 一线直达", "concept":"单条一次函数 · 认识函数栏", "objective":"只使用一条一次函数，让小球从起点滚到终点。", "hint":"先展开函数卡，再调整斜率、平移和定义域，把一条直线裁成合适的线段。",
      "bounds":[-9,-5,20,13], "start":[-7,7], "goal":[5,-0.5], "ball_radius":0.28, "goal_radius":0.7, "checkpoint_radius":0.5, "time_limit":25, "max_formulas":1,
      "templates":["linear"], "checkpoints":[], "obstacles":[], "circle_hazards":[],
      "initial_formulas":[{"template":"linear","parameters":{"a":-0.2,"b":4},"domain":[-8.5,10]}],
      "reference_formulas":[{"template":"linear","parameters":{"a":-0.567,"b":2.333},"domain":[-8.5,10]}],
      "tutorial":{
        "features":{"add_formula":false,"template_picker":false},
        "steps":[
          {"target":"formula_expand","title":"展开函数卡","text":"点击 f1 右侧的箭头，展开参数与定义域设置。","advance":"expand"},
          {"target":"formula_parameters","title":"调整这条直线","text":"拖动 a 斜率与 b 上下平移，让直线经过起点和终点。","advance":"parameter_change"},
          {"target":"formula_domain","title":"把直线裁成线段","text":"拖动定义域的两个端点，只保留小球需要经过的部分。","advance":"domain_change"},
          {"target":"run_button","title":"运行验证","text":"点击运行。小球会沿这条线段滚向终点。","advance":"run"}
        ]
      }
    },
    {
      "id":"tutorial_piecewise", "title":"第二课 · 分段绕障", "concept":"两条一次函数 · 学会添加函数", "objective":"用两段一次函数绕开红色障碍，连接起点与终点。", "hint":"一条直线会穿过障碍。添加第二条函数，把左右两段分别调整到障碍下方。",
      "bounds":[-9,-5,20,13], "start":[-7,7], "goal":[5,-0.5], "ball_radius":0.28, "goal_radius":0.7, "checkpoint_radius":0.5, "time_limit":30, "max_formulas":3,
      "templates":["linear"], "checkpoints":[], "obstacles":[[-1.5,3,2,1.2]], "circle_hazards":[],
      "initial_formulas":[{"template":"linear","parameters":{"a":-0.625,"b":2.625},"domain":[-8.5,10]}],
      "reference_formulas":[{"template":"linear","parameters":{"a":-0.52,"b":1.12},"domain":[-8.5,-1.5]},{"template":"linear","parameters":{"a":-0.12,"b":0.16},"domain":[0.5,6]}],
      "tutorial":{
        "features":{"add_formula":true,"template_picker":false},
        "steps":[
          {"target":"obstacle","title":"直路走不通了","text":"红色障碍挡在起点和终点之间。一条一次函数无法同时绕开它。","advance":"next"},
          {"target":"add_formula","title":"添加第二段轨道","text":"点击“添加函数”，用两条一次函数拼出分段路线。","advance":"formula_added"},
          {"target":"formula_list","title":"分别调整两段","text":"把第一条调到障碍左侧并向下倾斜；第二条放在障碍右侧，接到终点。记得裁短两条线的定义域。","advance":"next"},
          {"target":"run_button","title":"运行验证","text":"两段轨道之间要留出空隙，让小球越过障碍下方。点击运行试试看。","advance":"run"}
        ]
      }
    },
    {
      "id":"tutorial_parabola", "title":"第三课 · 一弧胜双线", "concept":"二次函数 · 选择模板与简洁度", "objective":"把两条直线换成一条二次函数，绕过障碍并抵达终点。", "hint":"展开函数后点击类型下拉框，选择二次函数。公式越少，通关后的简洁度评价越高。",
      "bounds":[-9,-5,20,13], "start":[-7,7], "goal":[5,-0.5], "ball_radius":0.28, "goal_radius":0.7, "checkpoint_radius":0.5, "time_limit":30, "max_formulas":3,
      "templates":["linear","quadratic"], "checkpoints":[], "obstacles":[[-1.5,3,2,1.2]], "circle_hazards":[],
      "initial_formulas":[{"template":"linear","parameters":{"a":-0.625,"b":2.625},"domain":[-8.5,10]}],
      "template_defaults":{"quadratic":{"a":0.05,"h":3,"k":-2}},
      "reference_formulas":[{"template":"quadratic","parameters":{"a":0.04,"h":4,"k":-1},"domain":[-8.5,10]}],
      "tutorial":{
        "features":{"add_formula":true,"template_picker":true},
        "steps":[
          {"target":"obstacle","title":"这一次，一条曲线就够","text":"上一关用了两条一次函数。现在试试用一条二次函数同时绕过障碍、连接起点和终点。","advance":"next"},
          {"target":"formula_expand","title":"展开函数卡","text":"点击 f1 右侧的箭头，展开函数设置。","advance":"expand"},
          {"target":"formula_picker","title":"切换函数类型","text":"点击函数类型下拉框，选择“二次函数 · 抛物线”。","advance":"template_quadratic"},
          {"target":"formula_parameters","title":"调整抛物线","text":"用 a 控制开口，用 h、k 移动顶点，让曲线从起点下方经过并穿过终点。","advance":"parameter_change"},
          {"target":"formula_domain","title":"裁剪曲线","text":"调整定义域，只保留有用的那段抛物线。","advance":"domain_change"},
          {"target":"formula_stat","title":"公式越少，评价越高","text":"这一关用 1 条公式就能完成上一关 2 条直线的工作。通关后会根据公式数量给出简洁度星级。","advance":"next"},
          {"target":"run_button","title":"运行验证","text":"点击运行，让小球沿一条抛物线到达终点。","advance":"run"}
        ]
      }
    },
