[node name="Title" type="Label" parent="HelpModal/Center/Card/Content"]
layout_mode = 2
theme_override_font_sizes/font_size = 27
text = "教程文档"

[node name="Body" type="Label" parent="HelpModal/Center/Card/Content"]
custom_minimum_size = Vector2(580, 0)
layout_mode = 2
text = "01   点击每条函数右侧的小箭头，展开函数、参数与定义域。\n02   拖动滑条，或输入参数并按 Enter，观察蓝色轨道。\n03   点击“添加函数”可以组合多条轨道；最多四条。\n04   双滑片分别调整定义域的下界和上界，下方两个数值框可微调。\n05   多条函数按列表顺序覆盖 x 范围；重叠时上面的函数优先。\n06   让轨道接到起点，经过黄色检查点，避开红色障碍。\n07   点击运行，把小球送进绿色终点。\n\n重试：保留当前函数、参数和定义域，重新调整。\n重置：恢复本关最初的模板、参数和定义域。\n\n滚轮上下平移；Shift + 滚轮左右平移；\nCtrl + 滚轮缩放；中键拖动；适应画布恢复全景。\n空格运行 / 暂停，R 重试，Esc 关闭弹窗 / 暂停。"
autowrap_mode = 3

[node name="Note" type="Label" parent="HelpModal/Center/Card/Content"]
layout_mode = 2
theme_override_colors/font_color = Color(0.51, 0.52, 0.55, 1)
theme_override_font_sizes/font_size = 13
text = "当前是界面原型：小球沿曲线匀速移动，重力与反弹待接入。\n检查点是必须经过的目标，重试会从起点重新开始。"
autowrap_mode = 3

