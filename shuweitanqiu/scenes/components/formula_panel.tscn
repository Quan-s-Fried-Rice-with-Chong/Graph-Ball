[gd_scene load_steps=3 format=3]
[ext_resource type="Script" path="res://scripts/ui/formula_panel.gd" id="1"]
[ext_resource type="Script" path="res://scripts/ui/icon_button.gd" id="2"]

[node name="FormulaPanel" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 0
script = ExtResource("1")

[node name="SummaryMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_right = 8

[node name="FormulaRow" type="HBoxContainer" parent="SummaryMargin"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
theme_override_constants/separation = 13

[node name="ColorDot" type="Label" parent="SummaryMargin/FormulaRow"]
layout_mode = 2
theme_override_colors/font_color = Color(0.286, 0.408, 0.71, 1)
theme_override_font_sizes/font_size = 15
text = "●"

[node name="ExpressionLabel" type="Label" parent="SummaryMargin/FormulaRow"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"MathLabel"
text = "y = −0.3x + 2.2"
autowrap_mode = 3
vertical_alignment = 1

[node name="ExpandButton" type="Button" parent="SummaryMargin/FormulaRow"]
unique_name_in_owner = true
custom_minimum_size = Vector2(38, 38)
layout_mode = 2
size_flags_vertical = 4
theme_type_variation = &"DisclosureButton"
tooltip_text = "调整公式"
toggle_mode = true
script = ExtResource("2")
symbol = "chevron_right"

[node name="DetailsMargin" type="MarginContainer" parent="."]
unique_name_in_owner = true
visible = false
layout_mode = 2
theme_override_constants/margin_left = 44
theme_override_constants/margin_top = 2
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 24

[node name="Details" type="VBoxContainer" parent="DetailsMargin"]
layout_mode = 2
theme_override_constants/separation = 15

[node name="TemplatePicker" type="OptionButton" parent="DetailsMargin/Details"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 15
text = "一次函数 · 直线"
clip_text = true

[node name="TemplateDescription" type="Label" parent="DetailsMargin/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.51, 0.52, 0.55, 1)
theme_override_font_sizes/font_size = 13
text = "a 改变倾斜方向，b 让整条直线上下移动。"
autowrap_mode = 3

[node name="ParameterList" type="VBoxContainer" parent="DetailsMargin/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 14

[node name="LockLabel" type="Label" parent="DetailsMargin/Details"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.51, 0.52, 0.55, 1)
theme_override_font_sizes/font_size = 12
text = "数值输入后按 Enter 确认。"
autowrap_mode = 3

[node name="Divider" type="HSeparator" parent="."]
layout_mode = 2

