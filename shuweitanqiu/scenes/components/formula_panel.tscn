[gd_scene load_steps=2 format=3]
[ext_resource type="Script" path="res://scripts/ui/formula_panel.gd" id="1"]

[node name="FormulaPanel" type="VBoxContainer"]
size_flags_horizontal = 3
theme_override_constants/separation = 12
script = ExtResource("1")

[node name="TopMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_top = 14
theme_override_constants/margin_right = 16

[node name="FormulaList" type="VBoxContainer" parent="TopMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 10

[node name="ActionMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_right = 16

[node name="AddFormulaButton" type="Button" parent="ActionMargin"]
unique_name_in_owner = true
custom_minimum_size = Vector2(0, 40)
layout_mode = 2
theme_type_variation = &"NavButton"
text = "＋  添加函数"
tooltip_text = "添加一条函数，并为它单独设置定义域"

[node name="LockMargin" type="MarginContainer" parent="."]
layout_mode = 2
theme_override_constants/margin_left = 18
theme_override_constants/margin_right = 16

[node name="LockLabel" type="Label" parent="LockMargin"]
unique_name_in_owner = true
layout_mode = 2
theme_override_colors/font_color = Color(0.51, 0.52, 0.55, 1)
theme_override_font_sizes/font_size = 12
text = "拖动滑条或输入数值；按 Enter 确认。"
autowrap_mode = 3

[node name="Divider" type="HSeparator" parent="."]
layout_mode = 2
